* {
    font: "JetBrainsMono Nerd Font 10";
    bg: rgba(30, 30, 46, 0.2);
    surface: rgba(49, 50, 68, 0.75);
    text: #cdd6f4;
    subtext: #a6adc8;
    sky: #89dceb;
    border-col: #45475a;
    sky: #89dceb;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2.5px;
    border-color: @sky;
    border-radius: 16px;

    /* Centered under the network-drawer icon in your waybar (measured at
       x-center ~1151px on a 1364px-wide screen). Same reasoning as
       volume-island.rasi: anchor "north" self-centers regardless of width. */
    location: north east;
    anchor: north;
    x-offset: -32px;
    y-offset: 8px;

    width: 360px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ message, listview ];
    spacing: 8px;
}

message {
    background-color: transparent;
    border: 0px 0px 1px 0px;
    border-color: @border-col;
    padding: 0px 4px 8px 4px;
}

textbox {
    background-color: transparent;
    text-color: @subtext;
    font: "JetBrainsMono Nerd Font 8";
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 4;
    cycle: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    background-color: transparent;
    text-color: @text;
    border-radius: 10px;
    padding: 8px 10px;
    orientation: horizontal;
    cursor: pointer;
}

element selected {
    background-color: @surface;
    text-color: @sky;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
